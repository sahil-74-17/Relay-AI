# The ML service reads these from the environment (all optional).

# sentence-transformers (default, semantic embeddings, downloads ~90 MB on first run)
# hashing (lightweight lexical fallback for CI or offline machines; no download)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Must match vector(384) in the database schema.
EMBEDDING_DIM=384

# vader (default, fast, domain-tuned lexicon) | transformer (RoBERTa; needs `pip install transformers`)
SENTIMENT_BACKEND=vader
